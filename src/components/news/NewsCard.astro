---
import Heading from '@/components/typography/Heading.astro';
import Paragraph from '@/components/typography/Paragraph.astro';
import ResponsiveImage from '@/components/ui/responsive-image/ResponsiveImage.astro';
import type { NieuwsEntry } from '@/lib/nieuws';
import { formatNieuwsDate, nieuwsHref } from '@/lib/nieuws';
const { post, featured=false } = Astro.props as { post: NieuwsEntry; featured?: boolean };
const href=nieuwsHref(post); const tag=post.data.tags[0] ?? 'Nieuws';
---
<article class:list={['news-card',{'news-card--featured':featured}]}>
  {post.data.image && <a class="news-card__media" href={href} aria-label={`Lees ${post.data.title}`}><ResponsiveImage src={post.data.image} alt={post.data.imageAlt} sizes="(min-width: 60rem) 33vw, 100vw" class="news-card__image"/><span class="news-card__tag">{tag}</span></a>}
  <div class="news-card__body stack">
    <Paragraph variant="small" class="news-card__meta">{formatNieuwsDate(post.data.date)}</Paragraph>
    <Heading tag="h3" variant="h4" class="news-card__title"><a href={href}>{post.data.title}</a></Heading>
  </div>
</article>
<style lang="scss">
  .news-card {
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-l);
    background: var(--surface-page);
    box-shadow: 0 .35rem 1.4rem rgb(0 64 154/.06);
    transition: transform var(--duration-fast) ease-out, box-shadow var(--duration-fast) ease-out
  }

  .news-card:hover {
    transform: translateY(-.3rem);
    box-shadow: 0 1rem 2.5rem rgb(0 64 154/.14)
  }

  .news-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16/10;
    overflow: hidden;
    background: var(--surface-subtle)
  }

  .news-card__media :global(.news-card__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-fast) ease-out
  }

  .news-card:hover .news-card__media :global(.news-card__image) {
    transform: scale(1.03)
  }

  .news-card__tag {
    position: absolute;
    inset: var(--space-s) auto auto var(--space-s);
    padding: .4rem .75rem;
    border-radius: 999px;
    background: var(--color-brand-700);
    color: #fff;
    font-size: var(--text-small);
    font-weight: var(--fw-semibold)
  }

  .news-card__body {
    --stack-gap: var(--space-s);
    padding: var(--space-m);
    height: calc(100% - 1px)
  }

  .news-card__body :global(.text),
  .news-card__body :global(.heading) {
    margin: 0
  }

  .news-card__meta {
    color: var(--text-muted)
  }

  .news-card__title a {
    color: inherit;
    text-decoration: none
  }

  .news-card__title a:hover {
    text-decoration: underline;
    text-underline-offset: .15em
  }

  .news-card__excerpt {
    color: var(--text-secondary)
  }

  .news-card__button {
    margin-block-start: auto;
    align-self: flex-start
  }
</style>
