---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroModern from '@/components/sections/home/HeroModern.astro';
import ActionCards from '@/components/sections/home/ActionCards.astro';
import AlbumCard from '@/components/media/AlbumCard.astro';
import {getCollection as getMediaCollection} from 'astro:content';
const albums=(await getMediaCollection('media')).map(entry=>({slug:entry.id,...entry.data,images:entry.data.images.map(image=>image.src)}));
import Section from '@/components/wrapper/Section.astro';
import Button from '@/components/ui/button/Button.astro';
import { getCollection } from 'astro:content';
import NewsCard from '@/components/news/NewsCard.astro';
import Eyebrow from '@/components/typography/Eyebrow.astro';
import Heading from '@/components/typography/Heading.astro';
import Paragraph from '@/components/typography/Paragraph.astro';
import Grid from '@/components/wrapper/Grid.astro';
import FAQ from '@/components/sections/faq/FAQ.astro';
import Switcher from '@/components/layout/switcher/Switcher.astro';
const news=(await getCollection('nieuws')).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
---
<BaseLayout title="Hart voor de wijk" description="Stichting Wijkraad Koningshaven is er voor bewoners van Broekhoven 1, Fatima en Hoogvenne in Tilburg." isHome>
  <HeroModern />

  <!-- <Section class="ticker" aria-label="Thema's waar de wijkraad zich voor inzet" paddingTop="none" paddingBottom="none" width="full">
      <div>Wonen <i>•</i> Groen <i>•</i> Veiligheid <i>•</i> Welzijn <i>•</i> Bereikbaarheid <i>•</i> Ontmoeting <i>•</i> Initiatieven <i>•</i></div>
  </Section> -->

  <Section theme="dark" width="xl" class="intro">
    <Switcher threshold="48rem" gap="xl" class="intro__grid">
      <div>
        <Eyebrow label="Wat de wijkraad doet" />
        <Heading tag="h2" variant="h1">Wat leeft in de buurt,<br /><em>brengen wij verder.</em></Heading>
      </div>
      <div class="flow">
        <Paragraph variant="large" maxWidth={54}>
          Bewoners, organisaties en ondernemers kunnen via de wijkraad aandacht vragen voor wat zij belangrijk vinden. We ondersteunen initiatieven, organiseren activiteiten en vertegenwoordigen bewonersbelangen richting gemeente en partners.
        </Paragraph>
        <Button href="/over/" variant="ghost">Meer over de wijkraad →</Button>
      </div>
    </Switcher>
  </Section>

  <ActionCards />

  <Section theme="brand" width="xl" class="neighborhoods">
    <Switcher threshold="48rem" gap="xl" class="neighborhoods__grid">
      <div>
        <Eyebrow label="Eén wijk, drie buurten" />
        <Heading tag="h2" variant="h1">Koningshaven is<br /><em>waar mensen samenkomen.</em></Heading>
      </div>
      <div class="district-copy">
        <Paragraph variant="large">De stichting richt zich op <strong>Broekhoven 1, Fatima en Hoogvenne</strong>. Elke buurt heeft een eigen karakter en eigen vragen; de wijkraad verbindt die verhalen tot één gezamenlijke stem.</Paragraph>
        <div class="district-pills flex-group"><span>Broekhoven 1</span><span>Fatima</span><span>Hoogvenne</span></div>
      </div>
    </Switcher>
  </Section>

  <Section width="xl" class="news">
    <div class="section-heading section-heading--row repel">
      <div>
        <Eyebrow label="Uit de wijk" />
        <Heading tag="h2" variant="h1">Nieuws, plannen<br />en <em>momenten.</em></Heading>
      </div><Button href="/nieuws/" variant="outline">Alle berichten</Button>
    </div>
    <Grid layout="thirds" gap="l">{news.slice(0,3).map(item =>
      <NewsCard post={item} />)}
    </Grid>
  </Section>

  <Section theme="brand" width="xl" class="cta">
    <Switcher threshold="48rem" gap="xl" class="cta__grid">
      <div>
        <Eyebrow label="Verrijk je Wijk" />
        <Heading tag="h2" variant="h1">Jouw idee kan<br /><em>de buurt bewegen.</em></Heading>
      </div>
      <div>
        <Paragraph variant="large">De gemeente Tilburg ondersteunt bewonersinitiatieven die sociale samenhang en leefbaarheid versterken. De wijkraad helpt bij aanvragen voor Koningshaven.</Paragraph><Button href="/verrijk-je-wijk/" variant="secondary" size="large">Bekijk voorwaarden & aanvraag</Button>
      </div>
    </Switcher>
  </Section>

  <Section width="xl" class="moments">
    <div class="repel section-heading">
      <div class="flow">
        <Eyebrow label="In beeld" />
        <Heading tag="h2" variant="h1">Onze wijk in <em>beeld.</em></Heading>
        <Paragraph variant="large">Herinneringen aan bijzondere momenten in Koningshaven.</Paragraph>
      </div><Button href="/media/" variant="outline">Alle albums</Button>
    </div>
    <Grid layout="thirds" gap="l">{albums.map(album=>
      <AlbumCard album={album} />)}
    </Grid>
  </Section>
  <FAQ />
</BaseLayout>

<style lang="scss">
  :global(body) {
    background: var(--surface-page)
  }

  .hero__title span {
    color: var(--brand-700)
  }

  .hero__copy {
    padding-block: var(--space-l)
  }

  .hero__map {
    position: relative;
    min-height: 36rem;
    background: #00409a;
    border-radius: 2rem;
    overflow: hidden;
    isolation: isolate;
    box-shadow: 0 1.5rem 4rem rgba(0, 64, 154, .16)
  }

  .district {
    position: absolute;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.35rem;
    border-radius: 2rem;
    color: #111;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .06);
    transform: rotate(var(--r));
    transition: transform .25s ease
  }

  .district:hover {
    transform: rotate(0) translateY(-4px)
  }

  .district span {
    font-size: .8rem;
    font-weight: 800;
    letter-spacing: .08em
  }

  .district strong {
    font-size: clamp(1.4rem, 2.5vw, 2.4rem);
    line-height: .95
  }

  .district--a {
    --r: -5deg;
    left: 7%;
    top: 8%;
    width: 52%;
    height: 43%;
    background: #d9e8ff
  }

  .district--b {
    --r: 4deg;
    right: 5%;
    top: 22%;
    width: 42%;
    height: 42%;
    background: #d9e8ff
  }

  .district--c {
    --r: -2deg;
    left: 20%;
    bottom: 4%;
    width: 57%;
    height: 38%;
    background: #b9d4ff
  }

  .hero__badge {
    position: absolute;
    right: 4%;
    bottom: 5%;
    z-index: 3;
    width: 8.5rem;
    height: 8.5rem;
    border-radius: 50%;
    background: #fff;
    display: grid;
    place-content: center;
    text-align: center;
    transform: rotate(8deg)
  }

  .hero__badge b {
    font-size: 2rem;
    color: #00409a;
    line-height: 1
  }

  .hero__badge small {
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: .08em;
    font-size: .65rem
  }

  .ticker {
    overflow: hidden;
    background: #edf4ff;
    border-block: 1px solid rgba(0, 0, 0, .18);
    padding: .75rem 0
  }

  .ticker div {
    white-space: nowrap;
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    font-weight: 800;
    letter-spacing: -.02em;
    word-spacing: 1.2rem;
    transform: translateX(-1rem)
  }

  .ticker i {
    font-style: normal;
    color: #00409a
  }

  .section-heading {
    margin-bottom: var(--space-xl)
  }

  .section-heading--row {
    --repel-gap: var(--space-l);
    align-items: flex-end
  }

  .action-list {
    border-top: 1px solid var(--border-default)
  }

  .action-row {
    display: grid;
    grid-template-columns: 5rem 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.4rem 1.2rem;
    border-bottom: 1px solid var(--border-default);
    color: inherit;
    text-decoration: none;
    transition: padding .2s ease, background .2s ease
  }

  .action-row:hover {
    padding-inline: 1.8rem
  }

  .action-row__nr {
    font-weight: 800
  }

  .action-row :global(.text) {
    margin: 0 0 .2rem;
    color: var(--text-muted)
  }

  .action-row b {
    white-space: nowrap
  }

  .action-row--yellow:hover {
    background: #edf4ff
  }

  .action-row--blue:hover {
    background: #00409a;
    color: white
  }

  .action-row--blue:hover :global(.text) {
    color: var(--brand-100)
  }

  .action-row--lilac:hover {
    background: #d9e8ff
  }

  .district-copy {
    font-size: var(--fs-1);
    max-width: 42rem
  }

  .district-pills {
    --flex-group-gap: .7rem;
    margin-top: 2rem
  }

  .district-pills span {
    padding: .55rem .9rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: .9rem;
    font-weight: 700
  }

  .cta .button {
    margin-top: var(--space-m)
  }

  @media(max-width:52rem) {
    .hero__map {
      min-height: 26rem
    }

    .action-row {
      grid-template-columns: 3rem 1fr
    }

    .action-row b {
      grid-column: 2
    }

    .section-heading--row {
      align-items: flex-start
    }
  }
</style>
