---
import Heading from '@/components/typography/Heading.astro';
import Paragraph from '@/components/typography/Paragraph.astro';
import ResponsiveImage from '@/components/ui/responsive-image/ResponsiveImage.astro'; import type { TeamMember } from '@/data/team';
const {member}=Astro.props as {member:TeamMember}; const src=member.image ?? (member.gender==='vrouw'?'/images/team/avatar-vrouw.png':'/images/team/avatar-man.png'); const alt=member.imageAlt ?? (member.image?`Foto van ${member.name}`:`Standaard avatar voor ${member.name}`);
---
<article class="team-card">
  <div class="team-card__media">
    <ResponsiveImage src={src} alt={alt} class="team-card__image" sizes="(min-width:60rem) 20vw, 50vw" />
  </div>
  <div class="team-card__body stack">
    <Heading tag="h3" variant="h3">{member.name}</Heading>
    <Paragraph>{member.role}</Paragraph>
  </div>
</article>


<style lang="scss">
  .team-card {
    overflow: hidden;
    border-radius: var(--radius-l);
    background: var(--surface-page);
    color: var(--text-primary);
    border: 1px solid var(--border-default)
  }

  .team-card__media {
    aspect-ratio: 4/3;
    overflow: hidden;
    background: var(--surface-subtle)
  }

  .team-card__media :global(.team-card__image) {
    width: 100%;
    height: 100%;
    object-fit: cover
  }

  .team-card__body {
    --stack-gap: var(--space-2xs);
    padding: var(--space-m)
  }

  .team-card__body :global(.heading),
  .team-card__body :global(.text) {
    margin: 0
  }
</style>
