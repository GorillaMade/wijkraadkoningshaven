
---
/**
 * Nav
 *
 * Semantische hoofdnavigatie met vaste BEM-classnames.
 *
 * - Gebruikt standaard siteConfig.navigation.
 * - Markeert actieve pagina's en onderliggende pagina's.
 * - Gebruikt Alpine.js voor de mobiele navigatie.
 * - Bevat uitsluitend navigatie, geen headerlayout.
 */

import { siteConfig } from "@/config/site";

type NavItem = {
    label: string;
    href: string;
};

interface Props {
    items?: NavItem[];
    ariaLabel?: string;
    class?: string;
}

const {
    items = siteConfig.navigation,
    ariaLabel = "Hoofdnavigatie",
    class: className,
} = Astro.props;

const normalizePath = (path: string): string => {
    return path.replace(/\/+$/, "") || "/";
};

const currentPath = normalizePath(Astro.url.pathname);

const isActive = (href: string): boolean => {
    const url = new URL(href, Astro.url);

    if (url.origin !== Astro.url.origin) {
        return false;
    }

    const itemPath = normalizePath(url.pathname);

    return (
        currentPath === itemPath ||
        (
            itemPath !== "/" &&
            currentPath.startsWith(`${itemPath}/`)
        )
    );
};
---

<nav
    id="site-nav"
    class:list={["site-nav", className]}
    aria-label={ariaLabel}
    :class="{ 'open': open }"
>
    <ul class="site-nav__list">
        {
            items.map((item) => (
                <li class="site-nav__item">
                    <a
                        class="site-nav__link"
                        href={item.href}
                        aria-current={
                            isActive(item.href)
                                ? "page"
                                : undefined
                        }
                    >
                        {item.label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<style lang="scss">
    .site-nav {
        display: none;
        width: 100%;

        &__list {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: var(--space-m);

            margin: 0;
            padding: 0;

            list-style: none;
        }

        &__link {
            display: inline-flex;
            align-items: center;

            color: inherit;
            text-decoration: none;

            transition:
                color var(--duration-fast) var(--ease-out);

            &:hover {
                color: var(--action-primary);
            }

            &[aria-current="page"] {
                font-weight: var(--fw-semibold);
            }

            &:focus-visible {
                outline: var(--focus-width) solid
                    var(--focus-color);

                outline-offset: var(--focus-offset);
            }
        }

        /*
         * Mobiel: Alpine.js opent het menu.
         */
        &.open {
            display: block;
        }
    }

    /*
     * Desktop: altijd zichtbaar.
     */
    @media (min-width: 976px) {
        .site-nav {
            display: block;
            width: auto;

            &__list {
                flex-direction: row;
                flex-wrap: wrap;
                align-items: center;
            }
        }
    }

    @media (width < 976px) {
        .site-nav {
            order: 3;
        }
    }
</style>
