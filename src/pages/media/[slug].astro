
---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/wrapper/Section.astro';
import Grid from '@/components/wrapper/Grid.astro';
import Eyebrow from '@/components/typography/Eyebrow.astro';
import Heading from '@/components/typography/Heading.astro';
import Paragraph from '@/components/typography/Paragraph.astro';
import ResponsiveImage from '@/components/ui/responsive-image/ResponsiveImage.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
    const entries = await getCollection('media');

    return entries.map((entry) => ({
        params: {
            slug: entry.id,
        },
        props: {
            album: {
                slug: entry.id,
                ...entry.data,
                images: entry.data.images.map((image) => image.src),
            },
        },
    }));
}

const { album } = Astro.props;
---

<BaseLayout
    title={album.title}
    description={album.description}
>
    <Section
        width="xl"
        paddingTop="xl"
        paddingBottom="xl"
    >
        <div class="intro stack flow">
            <a href="/media/" class="back">
                ← Alle albums
            </a>

            <Eyebrow label="Fotoalbum · Koningshaven" />

            <Heading tag="h1" variant="display">
                {album.title}
            </Heading>

            <Paragraph variant="large">
                {album.description}
            </Paragraph>

            <Paragraph variant="small">
                {album.images.length} foto's
            </Paragraph>
        </div>

        <!-- Alpine beheert de galerij en lightbox. -->
        <div
            class="gallery"
            x-data={`{
                images: ${JSON.stringify(album.images)},
                active: 0,

                open(index) {
                    this.active = index;
                    this.$refs.lightbox.showModal();
                },

                close() {
                    this.$refs.lightbox.close();
                },

                next() {
                    this.active =
                        (this.active + 1) % this.images.length;
                },

                previous() {
                    this.active =
                        (this.active - 1 + this.images.length)
                        % this.images.length;
                }
            }`}
        >
            <Grid
                minItemSize="16rem"
                placement="auto-fit"
                gap="m"
            >
                {
                    album.images.map((src, index) => (
                        <a
                            class="photo"
                            href={src}
                            aria-label={`Bekijk foto ${index + 1} van ${album.images.length}`}
                            @click={`$event.preventDefault(); open(${index})`}
                        >
                            <ResponsiveImage
                                src={src}
                                alt={`${album.title}, foto ${index + 1}`}
                            />

                            <span aria-hidden="true">
                                {String(index + 1).padStart(2, '0')}
                            </span>
                        </a>
                    ))
                }
            </Grid>

            <!-- Native dialog verzorgt de overlay en focus. -->
            <dialog
                class="lightbox"
                x-ref="lightbox"
                aria-label="Fotogalerij"
                @keydown.right.prevent="next()"
                @keydown.left.prevent="previous()"
                @click="if ($event.target === $el) close()"
            >
                <div class="lightbox__inner">
                    <button
                        class="lightbox__close"
                        type="button"
                        aria-label="Sluit fotogalerij"
                        @click="close()"
                    >
                        &times;
                    </button>

                    <div class="lightbox__stage">
                        <button
                            class="lightbox__arrow"
                            type="button"
                            aria-label="Vorige foto"
                            @click="previous()"
                        >
                            <span aria-hidden="true">←</span>
                        </button>

                        <img
                            class="lightbox__image"
                            :src="images[active]"
                            :alt="`Foto ${active + 1} van ${images.length}`"
                        />

                        <button
                            class="lightbox__arrow"
                            type="button"
                            aria-label="Volgende foto"
                            @click="next()"
                        >
                            <span aria-hidden="true">→</span>
                        </button>
                    </div>

                    <div
                        class="lightbox__counter"
                        aria-live="polite"
                    >
                        <span x-text="active + 1"></span>
                        <span aria-hidden="true">/</span>
                        <span x-text="images.length"></span>
                    </div>
                </div>
            </dialog>
        </div>
    </Section>
</BaseLayout>

<style lang="scss">
    /*
     * Introductie
     */
    .intro {
        max-width: 52rem;
        margin-bottom: clamp(2rem, 6vw, 5rem);
    }

    .back {
        color: var(--text-brand);
        font-weight: var(--fw-semibold);
        text-decoration: none;

        &:hover {
            text-decoration: underline;
        }
    }

    /*
     * Fotogrid
     */
    .photo {
        position: relative;

        display: block;
        aspect-ratio: 4 / 3;
        overflow: hidden;

        border-radius: var(--radius-m);
        background: var(--surface-subtle);

        :global(img) {
            display: block;

            width: 100%;
            height: 100%;

            object-fit: cover;

            transition: transform 400ms ease;
        }

        &:hover :global(img) {
            transform: scale(1.055);
        }

        &:focus-visible {
            outline:
                var(--focus-width, 2px)
                solid
                var(--focus-color, currentColor);

            outline-offset: var(--focus-offset, 4px);
        }

        span {
            position: absolute;
            bottom: var(--space-s);
            left: var(--space-s);

            padding:
                var(--space-3xs)
                var(--space-2xs);

            border-radius: var(--radius-s);

            background: var(--surface-page);
            color: var(--text-brand);

            font-size: var(--text-small);
            font-weight: var(--fw-semibold);
            font-variant-numeric: tabular-nums;
        }
    }

    /*
     * Lightbox
     */
    .lightbox {
        position: fixed;

        width: 100%;
        max-width: none;
        height: 100%;
        max-height: none;

        margin: 0;
        padding: 0;

        border: 0;

        background: transparent;
        color: white;

        &::backdrop {
            background: rgb(0 12 28 / 94%);
        }

        &[open] {
            display: grid;
            place-items: center;
        }

        &__inner {
            position: relative;

            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: var(--space-m);

            width: 100%;
            height: 100%;
            padding: clamp(1rem, 3vw, 2rem);
        }

        /*
         * Sluitknop
         */
        &__close {
            position: absolute;
            top: var(--space-m);
            right: var(--space-m);
            z-index: 2;

            display: grid;
            place-items: center;

            width: 2.75rem;
            height: 2.75rem;
            padding: 0;

            border: 1px solid rgb(255 255 255 / 30%);
            border-radius: 50%;

            background: rgb(255 255 255 / 10%);
            color: white;

            font-size: 1.75rem;
            line-height: 1;

            cursor: pointer;
        }

        /*
         * Foto en navigatie
         */
        &__stage {
            display: grid;
            grid-template-columns:
                auto
                minmax(0, 1fr)
                auto;

            align-items: center;
            gap: clamp(0.5rem, 2vw, 2rem);

            width: 100%;
            min-height: 0;
            flex: 1;
        }

        &__image {
            display: block;

            width: 100%;
            height: 100%;

            max-height: 80dvh;
            min-height: 0;

            object-fit: contain;
        }

        &__arrow {
            display: grid;
            place-items: center;

            width: clamp(2.25rem, 5vw, 3.5rem);
            height: clamp(2.25rem, 5vw, 3.5rem);
            padding: 0;

            border: 1px solid rgb(255 255 255 / 30%);
            border-radius: 50%;

            background: rgb(255 255 255 / 10%);
            color: white;

            font: inherit;
            font-size: 1.5rem;

            cursor: pointer;

            &:hover,
            &:focus-visible {
                background: rgb(255 255 255 / 22%);
            }
        }

        /*
         * Huidige foto / totaal
         */
        &__counter {
            display: flex;
            justify-content: center;
            gap: var(--space-xs);

            color: rgb(255 255 255 / 80%);

            font-size: var(--text-small);
            font-variant-numeric: tabular-nums;
        }

        button:focus-visible {
            outline: 2px solid white;
            outline-offset: 4px;
        }
    }

    @media (max-width: 48rem) {
        .lightbox {
            &__inner {
                padding-inline: var(--space-xs);
            }

            &__stage {
                gap: var(--space-xs);
            }

            &__arrow {
                font-size: 1.25rem;
            }
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .photo :global(img) {
            transition: none;
        }

        .photo:hover :global(img) {
            transform: none;
        }
    }
</style>
